{
  "name": "codergosha-site",
  "version": "2.0.0",
  "private": true,
  "description": "Personal site — Eleventy + Tailwind",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "sync": "node scripts/sync-content.js",
    "dev": "npm run sync && eleventy --serve --watch",
    "build": "npm run sync && eleventy",
    "preview": "serve dist -l 8080",
    "portrait:pdf": "node scripts/prepare-portrait-pdf.mjs",
    "portrait:web": "node scripts/optimize-portrait.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "resume:pdf": "node scripts/prepare-portrait-pdf.mjs && node scripts/generate-resume-pdf.mjs",
    "lint": "node --check scripts/sync-content.js && node --check eleventy.config.cjs && node --check scripts/generate-resume-pdf.mjs && node --check scripts/generate-icons.mjs && node --check scripts/generate-og-image.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-navigation": "^0.3.2",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "html-minifier": "^4.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "puppeteer": "^24.8.2",
    "serve": "^14.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17"
  }
}
