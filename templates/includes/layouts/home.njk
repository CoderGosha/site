---
layout: layouts/site.njk
---
<main id="main" class="home-main">
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">{{ greeting }}</p>
      <h1>{{ heroTitle }}</h1>
      <div class="accent-line" aria-hidden="true"></div>
      <div class="hero-lead">
        <p class="lead">{{ lead }}</p>
        {% if leadMore %}<p class="lead">{{ leadMore }}</p>{% endif %}
        {% if leadExtra %}<p class="lead">{{ leadExtra }}</p>{% endif %}
      </div>

      <div class="action-row">
        <a class="btn primary" href="{{ resumeUrl | url }}">{{ ctaResume }}</a>
        <a class="btn secondary" href="{{ contactUrl | url }}">{{ ctaContact }}</a>
      </div>

      <div class="stat-row" aria-label="{{ statsLabel }}">
        {% for stat in stats %}
          <span><strong>{{ stat.value }}</strong><em>{{ stat.label }}</em></span>
        {% endfor %}
      </div>
    </div>

    <aside class="profile-panel" aria-label="{{ profileLabel }}">
      <figure class="portrait-photo">
        <img src="{{ portrait | url }}" alt="{{ portraitAlt | default(name) }}" width="640" height="800" loading="eager" decoding="async">
      </figure>
    </aside>
  </section>
</main>
