---
permalink: false
---
<!doctype html>
<html lang="{{ intl.lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="{{ '/css/resume-pdf.min.css' | url }}">
  </head>
  <body class="resume-pdf-body">
    <main class="resume-pdf" id="main">
      <aside class="resume-pdf__aside" aria-label="{{ pdfLabels.contact | default('Контакты') }}">
        <figure class="resume-pdf__photo">
          <img src="{{ (portraitPdf or portrait) | url }}" alt="{{ portraitAlt }}" width="336" height="336" decoding="sync">
        </figure>

        <div class="resume-pdf__aside-block">
          <h2 class="resume-pdf__aside-title">{{ pdfLabels.contact | default('Контакты') }}</h2>
          <ul class="resume-pdf__contact">
            <li>{{ contact.location }}</li>
            <li>
              <span class="resume-pdf__label">{{ pdfLabels.email | default('Email') }}</span>
              <span class="resume-pdf__value">{{ contact.email }}</span>
            </li>
            <li>
              <span class="resume-pdf__label">{{ pdfLabels.telegram | default('Telegram') }}</span>
              <span class="resume-pdf__value">@CoderGosha</span>
            </li>
            <li>
              <span class="resume-pdf__label">{{ pdfLabels.github | default('GitHub') }}</span>
              <span class="resume-pdf__value">CoderGosha</span>
            </li>
          </ul>
        </div>

        {% if highlights %}
          <div class="resume-pdf__aside-block">
            <ul class="resume-pdf__stats">
              {% for item in highlights %}
                <li>
                  <strong>{{ item.value }}</strong>
                  <span>{{ item.label }}</span>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div class="resume-pdf__aside-block">
          <h2 class="resume-pdf__aside-title">{{ pdfLabels.stack | default(stackTitle) | default('Технологии') }}</h2>
          <div class="resume-pdf__pills">
            {% for pill in stackPills %}
              <span>{{ pill }}</span>
            {% endfor %}
          </div>
        </div>
      </aside>

      <div class="resume-pdf__content">
        <div class="resume-pdf__intro">
          <header class="resume-pdf__header">
            <h1>{{ name }}</h1>
            <p class="resume-pdf__role">{{ role }}</p>
          </header>

          <section class="resume-pdf__section">
            <h2>{{ pdfLabels.summary | default('О себе') }}</h2>
            <div class="resume-pdf__summary">
              <p>{{ pageLead }}{% if pageLeadMore %} {{ pageLeadMore }}{% endif %}</p>
            </div>
          </section>

          <section class="resume-pdf__section">
            <h2>{{ pdfLabels.profile | default(profileTitle) | default('Ключевые направления') }}</h2>
            <ul class="resume-pdf__list resume-pdf__list--compact">
              {% for item in profileItems %}
                <li>{{ item }}</li>
              {% endfor %}
            </ul>
          </section>
        </div>

        <section class="resume-pdf__section resume-pdf__section--experience">
          <h2>{{ pdfLabels.experience | default('Опыт') }}</h2>
          <div class="resume-pdf__experience">
            {% for job in jobs %}
              <article class="resume-pdf__job">
                <h3>{{ job.name }}</h3>
                <p class="resume-pdf__meta">{{ job.work_period }} · {{ job.post }}{% if job.work_type %} · {{ job.work_type }}{% endif %}</p>
                {% for desc in job.descriptions %}
                  <div class="resume-pdf__job-block">
                    <p class="resume-pdf__job-text">{{ desc.description }}</p>
                    {% if desc.technology %}
                      <p class="resume-pdf__job-tech"><span>{{ pdfLabels.stackLabel | default('Технологии') }}:</span> {{ desc.technology | replace('\n', ' · ') }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </article>
            {% endfor %}
            {% for item in edu %}
              <article class="resume-pdf__job">
                <h3>{{ item.name }}</h3>
                <p class="resume-pdf__meta">{{ item.work_period }} · {{ item.post }}{% if item.work_type %} · {{ item.work_type }}{% endif %}</p>
                {% for desc in item.descriptions %}
                  <div class="resume-pdf__job-block">
                    <p class="resume-pdf__job-text">{{ desc.description }}</p>
                    {% if desc.result %}
                      <p class="resume-pdf__job-tech">{{ desc.result }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </article>
            {% endfor %}
          </div>
        </section>
      </div>
    </main>
  </body>
</html>
