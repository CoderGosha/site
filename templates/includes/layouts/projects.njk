---
layout: layouts/site.njk
---
<main id="main" class="content-page">
  <section class="page-hero compact">
    <div>
      <p class="kicker">{{ pageKicker | default('Проекты') }}</p>
      <h1>{{ pageTitle }}</h1>
      <p class="lead">{{ pageLead }}</p>
    </div>
  </section>

  <section class="project-list" aria-label="{{ projectsLabel | default('Избранные проекты') }}">
    {% for project in projects %}
      <article class="project-card"{% if project.stack %} data-project-stack="{{ project.stack }}"{% endif %}>
        <span class="project-index">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
        <div>
          <h2>{{ project.name }}</h2>
          <p>{{ project.description.description }}</p>
        </div>
        <p class="meta">{{ project.work_period }} · {{ project.description.technology }}</p>
      </article>
    {% endfor %}
  </section>
</main>
