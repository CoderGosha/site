---
layout: layouts/site.njk
contactRail: compact
---
<main id="main" class="content-page">
  <section class="page-hero">
    <p class="kicker">{{ pageKicker | default('Резюме') }}</p>
    <h1>{{ pageTitle | default('Руководитель группы разработки на C#.') }}</h1>
    <p class="lead">{{ pageLead }}</p>
  </section>

  <section class="two-column">
    <article class="paper-card large">
      <h2>{{ profileTitle | default('Профиль') }}</h2>
      <ul class="clean-list">
        {% for item in profileItems %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
    </article>
    <aside class="paper-card">
      <h2>{{ stackTitle | default('Основной стек') }}</h2>
      <div class="pill-cloud">
        {% for pill in stackPills %}
          <span>{{ pill }}</span>
        {% endfor %}
      </div>
      <p>{{ stackNote }}</p>
    </aside>
  </section>

  <section class="cards-three">
    {% for job in jobs %}
      {% if loop.index <= 3 %}
      <article class="paper-card">
        <h2>{{ job.name }}</h2>
        <p class="meta">{{ job.work_period }} · {{ job.post }}</p>
        <p>{{ job.descriptions[0].description }}</p>
      </article>
      {% endif %}
    {% endfor %}
  </section>
</main>
