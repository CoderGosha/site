---
layout: layouts/site.njk
---
{% from "link-icons.njk" import forUrl %}
<main id="main" class="content-page">
  <section class="page-hero">
    <p class="kicker">{{ pageKicker | default('Контакты') }}</p>
    <h1>{{ pageTitle }}</h1>
    {% if pageLead %}<p class="lead">{{ pageLead }}</p>{% endif %}
  </section>

  <section>
    <article class="paper-card">
      <div class="contact-list">
        {% for channel in channels %}
          <a href="{{ channel.url }}" class="contact-link">
            <span class="link-icon-box" aria-hidden="true">{{ forUrl(channel.url) }}</span>
            <span>{{ channel.label }}</span>
          </a>
        {% endfor %}
      </div>
    </article>
  </section>
</main>
